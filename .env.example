# ==============================================================================
# EASYTRADER / DRISHTI REAL OAUTH 2.0 & OIDC PRODUCTION ENVIRONMENT CONFIG
# ==============================================================================

# --- NextAuth / Auth.js Base Settings ---
# Generate secret: `npx auth secret` or `openssl rand -base64 32`
NEXTAUTH_SECRET=your_nextauth_secret_32_characters_minimum
NEXTAUTH_URL=http://localhost:3000

# --- 1. GOOGLE OAUTH 2.0 (Google Cloud Console) ---
# Portal: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# --- 2. MICROSOFT ENTRA ID / AZURE AD (Microsoft Entra Admin Center) ---
# Portal: https://entra.microsoft.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=your_microsoft_application_client_id
AZURE_AD_CLIENT_SECRET=your_microsoft_client_secret
AZURE_AD_TENANT_ID=common # Use 'common' for multi-tenant & personal accounts, or your Azure Tenant ID

# --- 3. APPLE SIGN IN (Apple Developer Portal) ---
# Portal: https://developer.apple.com/account/resources/identifiers/list
# Authorized Return URL: http://localhost:3000/api/auth/callback/apple
APPLE_ID=com.drishti.easytrader.serviceid
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_APPLE_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----"

# --- AWS Database & Storage ---
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=eu-north-1
AWS_DYNAMODB_TABLE_SHOPS=drishti-shops